# Mobile front-end: point this at the separate beta server before installing.
VITE_SYNCROBEAT_API_URL=https://syncrobeat.onrender.com
VITE_SYNCROBEAT_SHARE_URL=https://syncrobeat.onrender.com

# Server: only specific rooms can test Pro before store billing is connected.
# A beta grant is a test permission, not a paid subscription.
SYNCROBEAT_RELEASE_CHANNEL=beta
BETA_PRO_ROOM_CODES=
# Origins allowed to read the API from the native WebViews.
NATIVE_APP_ORIGINS=https://localhost,capacitor://localhost
