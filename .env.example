# Mobile front-end: point this at the separate beta server before installing.
VITE_SYNCROBEAT_API_URL=https://syncrobeat.onrender.com
VITE_SYNCROBEAT_SHARE_URL=https://syncrobeat.onrender.com

# Server: only specific rooms can test Pro before store billing is connected.
# A beta grant is a test permission, not a paid subscription.
SYNCROBEAT_RELEASE_CHANNEL=beta
BETA_PRO_ROOM_CODES=
# Origins allowed to read the API from the native WebViews.
NATIVE_APP_ORIGINS=https://localhost,capacitor://localhost

# --- Accounts, for the paid plan only -------------------------------------
# Both of these are optional. With either one missing the server runs exactly as it always has:
# solo practice, the free duo and joining by room code never touch any of this.

# Postgres for accounts, sessions and who has paid. Set it in the host's dashboard, never here:
# this file is committed. Neon, Supabase and Render Postgres all work.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The Google sign-in client. This one is NOT a secret -- it is written into the page and anyone can
# read it. The client *secret* is never needed: we verify Google's token instead of exchanging it.
GOOGLE_CLIENT_ID=1038326966228-p6mgbbtip7rf7lk5mf65gasq4a6uvjr2.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=1038326966228-p6mgbbtip7rf7lk5mf65gasq4a6uvjr2.apps.googleusercontent.com
