{
  "name": "syncrobeat",
  "private": true,
  "version": "1.0.0",
  "description": "Metrónomo sincronizado en tiempo real para bandas: el baterista controla el tempo y todos escuchan el mismo click.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts --prod",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:server": "node --import tsx --test tests/server/server.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:unit && npm run test:server && npm run test:e2e",
    "brand": "node scripts/brand-assets.mjs && node scripts/brand-preview.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "potrace": "^2.1.8",
    "typescript": "^7.0.2"
  }
}
